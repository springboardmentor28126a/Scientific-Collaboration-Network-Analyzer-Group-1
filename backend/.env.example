# Supabase API storage configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-key

# SQLAlchemy connection string from the Supabase database connection settings
SCNA_DATABASE_URL=postgresql+psycopg2://postgres.<project-ref>:<database-password>@<pooler-host>:5432/postgres?sslmode=require

# Required for deployed environments
SCNA_SECRET_KEY=replace-with-a-long-random-secret

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
CAPTCHA_MODE=development
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
CAPTCHA_REQUIRED=true
CAPTCHA_VERIFY_URL=https://www.google.com/recaptcha/api/siteverify

# CAPTCHA_SITE_KEY is public; CAPTCHA_SECRET_KEY must remain backend-only.
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=gpt-4o-mini
