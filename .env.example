# PostgreSQL container settings
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Existing Supabase PostgreSQL connection URL used by the backend.
SCNA_DATABASE_URL=postgresql+psycopg2://user:password@pooler-host:5432/postgres?sslmode=require

# Required outside local-only development.
SCNA_SECRET_KEY=

# Comma-separated browser origins allowed by FastAPI.
SCNA_CORS_ORIGINS=

# Required for group-file Supabase Storage integration.
SUPABASE_URL=
SUPABASE_KEY=

# Public API URL baked into the production frontend bundle.
VITE_API_URL=

# Email delivery (SMTP). Required for real OTP/security emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Server-generated alphanumeric CAPTCHA. The answer is stored only as a hash.
CAPTCHA_REQUIRED=true

# SCNA Research AI (OpenRouter OpenAI-compatible provider; backend only)
AI_PROVIDER=openrouter
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=your-openrouter-api-key
AI_MODEL=openrouter/free
