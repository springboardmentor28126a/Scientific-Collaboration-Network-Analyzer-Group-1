# PostgreSQL container settings
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Existing Supabase PostgreSQL connection URL used by the backend.
SCNA_DATABASE_URL=postgresql+psycopg2://user:password@pooler-host:5432/postgres?sslmode=require

# Required outside local-only development.
SCNA_SECRET_KEY=

# Comma-separated browser origins allowed by FastAPI.
SCNA_CORS_ORIGINS=

# Required for group-file Supabase Storage integration.
SUPABASE_URL=
SUPABASE_KEY=

# Public API URL baked into the production frontend bundle.
VITE_API_URL=

# Email delivery (SMTP). Required for real OTP/security emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# CAPTCHA (Google reCAPTCHA-compatible verification endpoint)
CAPTCHA_MODE=development
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
CAPTCHA_REQUIRED=true
CAPTCHA_VERIFY_URL=https://www.google.com/recaptcha/api/siteverify

# CAPTCHA_SITE_KEY is public and is baked into the frontend widget at Docker build time.
# CAPTCHA_SECRET_KEY is backend-only; use real values only in ignored .env files.

# SCNA Research AI (OpenAI-compatible provider)
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=gpt-4o-mini
